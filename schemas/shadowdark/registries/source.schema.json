{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadowdark source registry",
  "type": "object",
  "required": [
    "ruleset_id",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "ruleset_id": {
      "const": "shadowdark"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "book_id",
          "citation_code",
          "edition_or_printing",
          "provenance"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "book_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "citation_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]*$"
          }
        },
        "additionalProperties": true
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadowdark inactive character-race registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "ruleset_id",
    "version",
    "status",
    "scope",
    "membership_policy",
    "members",
    "groups",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "const": "shadowdark_character_races"
    },
    "ruleset_id": {
      "const": "shadowdark"
    },
    "version": {
      "const": "1.0"
    },
    "status": {
      "const": "inactive"
    },
    "scope": {
      "const": "pending_source_evidence"
    },
    "membership_policy": {
      "type": "object"
    },
    "members": {
      "const": []
    },
    "groups": {
      "const": []
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Basic D&D Graph Update Recommendation",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "status", "ruleset_id", "book_id", "source_id", "packet_id", "constitution_version"],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string"},
    "status": {"type": "string"},
    "ruleset_id": {"const": "basicdnd"},
    "book_id": {"const": "rc"},
    "source_id": {"const": "rc-steward-intake"},
    "packet_id": {"type": "string"},
    "constitution_version": {"const": "1.0"}
  }
}

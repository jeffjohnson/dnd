{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Basic D&D initial character-race registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "ruleset_id", "version", "status", "scope", "membership_policy", "members", "groups", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"const": "basicdnd_character_races"},
    "ruleset_id": {"const": "basicdnd"},
    "version": {"const": "1.0"},
    "status": {"const": "inactive"},
    "scope": {"const": "no_initial_playable_race_axis"},
    "membership_policy": {"type": "object"},
    "members": {"const": []},
    "groups": {"const": []},
    "notes": {"type": "array", "minItems": 1}
  }
}

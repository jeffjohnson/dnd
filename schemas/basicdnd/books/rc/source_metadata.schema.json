{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rules Cyclopedia Source Metadata",
  "type": "object",
  "required": ["ruleset_id", "book_id", "source_id"],
  "properties": {
    "ruleset_id": {"const": "basicdnd"},
    "book_id": {"const": "rc"},
    "source_id": {"const": "rc-steward-intake"},
    "edition_or_printing": {"type": "string"},
    "page_number_basis": {"type": "string"},
    "checksum": {"type": "string"}
  },
  "additionalProperties": true
}

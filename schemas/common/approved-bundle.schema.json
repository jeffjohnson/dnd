{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/common/approved-bundle.schema.json",
  "title": "Approved Bundle Manifest",
  "$comment": "contracts/WORK_QUEUES.md 1.9: an Approved bundle is one manifest plus checksummed components. Packet updates use an edge CSV. Direct decision-migration models pin their exact reviewed GUP YAML and validation report, so an Integrator never invents operations from prose or an absent CSV.",
  "allOf": [
    {
      "$ref": "artifact-envelope.schema.json"
    },
    {
      "if": {
        "properties": {
          "artifact_kind": {
            "const": "decision_migration"
          }
        },
        "required": [
          "artifact_kind"
        ]
      },
      "then": {
        "required": [
          "operation_model"
        ],
        "properties": {
          "operation_model": {
            "enum": [
              "decision_migration_v1",
              "decision_migration_v2",
              "decision_migration_v3"
            ]
          },
          "approves": {
            "required": [
              "review_id",
              "review_checksum",
              "gup_id",
              "gup_checksum"
            ]
          },
          "components": {
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "decision_migration"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "validation"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "edges"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "approves",
    "components"
  ],
  "properties": {
    "artifact_kind": {
      "enum": [
        "packet_update",
        "decision_migration"
      ]
    },
    "operation_model": {
      "enum": [
        "decision_migration_v1",
        "decision_migration_v2",
        "decision_migration_v3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^APPROVED-GUP-.+-r[0-9]{2}-r[0-9]{2}$",
      "description": "APPROVED-<gup-id>-rNN. The GUP ID already ends in its own -rNN, so a well-formed bundle ID carries two revision suffixes: the GUP's and the bundle's. The manifest filename is this ID plus .yaml."
    },
    "approves": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "gup_id"
      ],
      "description": "The Review that approved this bundle and the GUP it approved. WORK_QUEUES rule 5: a downstream artifact consumes its input by recording the exact upstream ID and checksum.",
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^REV-GUP-.+$"
        },
        "review_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "gup_id": {
          "type": "string",
          "pattern": "^GUP-.+-r[0-9]{2}$"
        },
        "gup_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "gur_id": {
          "type": "string",
          "pattern": "^GUR-.+-r[0-9]{2}$",
          "description": "Carried through from the GUP so the source lineage stays recoverable from the bundle alone."
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Every file in the bundle, each pinned by checksum. The manifest itself is not listed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "checksum"
        ],
        "properties": {
          "kind": {
            "enum": [
              "edges",
              "nodes",
              "report",
              "validation",
              "decision_migration"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative path. Published paths are provenance and must remain valid."
          },
          "checksum": {
            "$ref": "#/$defs/checksum"
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Set once an Integration record consumes this bundle. Its presence removes the bundle from the Integrator queue.",
      "properties": {
        "integration_id": {
          "type": "string",
          "pattern": "^INT-[0-9]{8}-[0-9]{3}$"
        },
        "integrated_on": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256, prefixed. Matches the form the Builder already writes for gur_checksum."
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/common/gup.schema.json",
  "title": "Graph Update Patch",
  "$comment": "contracts/WORK_QUEUES.md 1.2 gives a GUP exactly one lineage root, selected by artifact_kind. A packet update consumes one active-leaf GUR; a decision migration consumes approved Architect Decisions and has no GUR at all. The two roots are validated separately below: a declared kind is never reinterpreted to make an invalid artifact routable.",
  "allOf": [
    {
      "$ref": "artifact-envelope.schema.json"
    },
    {
      "$comment": "A decision migration must carry the alternate auditable root that stands in for GUR provenance. Suppressing the missing-GUR warning on artifact_kind alone would let any GUP bypass source lineage, so the Decision IDs, paths and checksums are required instead.",
      "if": {
        "properties": {
          "artifact_kind": {
            "const": "decision_migration"
          }
        },
        "required": [
          "artifact_kind"
        ]
      },
      "then": {
        "$ref": "#/$defs/decisionMigration"
      }
    },
    {
      "$comment": "A packet update names the GUR it consumed.",
      "if": {
        "properties": {
          "artifact_kind": {
            "const": "packet_update"
          }
        },
        "required": [
          "artifact_kind"
        ]
      },
      "then": {
        "$ref": "#/$defs/packetUpdate"
      }
    },
    {
      "$comment": "WORK_QUEUES 1.8 direct v1 operations are an explicit, narrow executable model. Published older migrations remain structurally valid history until a current revision declares the model.",
      "if": {
        "properties": {
          "operation_model": {
            "const": "decision_migration_v1"
          }
        },
        "required": [
          "operation_model"
        ]
      },
      "then": {
        "$ref": "#/$defs/directDecisionMigrationV1"
      }
    },
    {
      "$comment": "WORK_QUEUES 1.10 direct v2 is the separate bounded node-ID merge model.",
      "if": {
        "properties": {
          "operation_model": {
            "const": "decision_migration_v2"
          }
        },
        "required": [
          "operation_model"
        ]
      },
      "then": {
        "$ref": "#/$defs/directDecisionMigrationV2"
      }
    },
    {
      "$comment": "DEC-2026-0050 v3: one-to-one replacements with their closed paired repoints, plus blank endpoint-label normalization on enumerated rows. Kept separate from v1 so no existing v1 Decision gains a label operation nobody reviewed.",
      "if": {
        "properties": {
          "operation_model": {
            "const": "decision_migration_v3"
          }
        },
        "required": [
          "operation_model"
        ]
      },
      "then": {
        "$ref": "#/$defs/directDecisionMigrationV3"
      }
    }
  ],
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "artifact_kind": {
      "$comment": "Legacy GUPs omit this and are read as packet updates only where their GUR provenance is unambiguous. identity_merge_migration is the earlier spelling of the decision-migration root, not a third root: it stays accepted here so published history remains schema-valid, and it carries no lineage requirements because artifacts written before the contract could not have met them. Whether such an artifact reaches Reviewer is a queue rule, not a structural one, and WORK_QUEUES 1.2 answers it -- it is not ready until superseded by a conforming decision_migration revision.",
      "enum": [
        "packet_update",
        "decision_migration",
        "identity_merge_migration"
      ]
    },
    "approval_ready": {
      "type": "boolean"
    },
    "operation_model": {
      "enum": [
        "decision_migration_v1",
        "decision_migration_v2",
        "decision_migration_v3"
      ]
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}-[0-9]{4}$"
    },
    "packetUpdate": {
      "type": "object",
      "required": [
        "packet_id",
        "provenance"
      ],
      "properties": {
        "provenance": {
          "type": "object",
          "required": [
            "gur_id"
          ],
          "properties": {
            "gur_id": {
              "type": "string",
              "minLength": 1
            },
            "gur_checksum": {
              "$ref": "#/$defs/checksum"
            }
          }
        }
      }
    },
    "decisionMigration": {
      "type": "object",
      "required": [
        "lineage_id",
        "revision",
        "supersedes",
        "authority",
        "validation_report",
        "validation_report_checksum",
        "provenance"
      ],
      "properties": {
        "lineage_id": {
          "$comment": "Stable across every revision. packet_id cannot group these: independent migrations all carry cross-packet.",
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/decisionId"
          }
        },
        "validation_report": {
          "type": "string",
          "minLength": 1
        },
        "validation_report_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "canonical_changes": {
          "$comment": "WORK_QUEUES 1.2 condition 6: a Decision ID never substitutes for the rows to be reviewed, so each change carries its own before-state.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "canonical_row",
              "kind",
              "authority",
              "changes",
              "before"
            ],
            "properties": {
              "canonical_row": {
                "type": "integer",
                "minimum": 2
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "$ref": "#/$defs/decisionId"
              },
              "changes": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ]
                }
              },
              "before": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "$comment": "gur_id and gur_checksum are forbidden here. Their absence is the point: this artifact's root is the Decision record, and carrying either would claim a packet lineage it does not have.",
          "required": [
            "decision_inputs",
            "canonical_source",
            "canonical_checksum",
            "canonical_rows_read"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "gur_id"
                ]
              },
              {
                "required": [
                  "gur_checksum"
                ]
              }
            ]
          },
          "properties": {
            "decision_inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "path",
                  "checksum"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/decisionId"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checksum": {
                    "$ref": "#/$defs/checksum"
                  }
                }
              }
            },
            "canonical_source": {
              "type": "string",
              "minLength": 1
            },
            "canonical_checksum": {
              "$ref": "#/$defs/checksum"
            },
            "canonical_rows_read": {
              "$comment": "The baseline the plan was made against. If it drifts, the reviewed plan is stale and must be re-issued rather than applied.",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "edgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_label",
        "edge_type",
        "target_id",
        "target_label",
        "aspect",
        "condition",
        "polarity",
        "polarity_basis",
        "book",
        "page",
        "section",
        "evidence",
        "pass",
        "status",
        "supersession_basis",
        "general_rule_id",
        "review_flag"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "source_label": {
          "type": "string"
        },
        "edge_type": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "target_label": {
          "type": "string"
        },
        "aspect": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "polarity": {
          "type": "string"
        },
        "polarity_basis": {
          "type": "string"
        },
        "book": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "pass": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "supersession_basis": {
          "type": "string"
        },
        "general_rule_id": {
          "type": "string"
        },
        "review_flag": {
          "type": "string"
        }
      }
    },
    "fieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "directDecisionMigrationV1": {
      "type": "object",
      "required": [
        "artifact_kind",
        "operation_model",
        "node_changes",
        "canonical_changes",
        "canonical_removals",
        "provenance"
      ],
      "properties": {
        "artifact_kind": {
          "const": "decision_migration"
        },
        "operation_model": {
          "const": "decision_migration_v1"
        },
        "provenance": {
          "type": "object",
          "required": [
            "registry_source",
            "registry_checksum",
            "registry_rows_read"
          ],
          "properties": {
            "registry_source": {
              "type": "string",
              "minLength": 1
            },
            "registry_checksum": {
              "$ref": "#/$defs/checksum"
            },
            "registry_rows_read": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "node_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "additions_proposed",
            "relabels",
            "replacements"
          ],
          "properties": {
            "additions_proposed": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "proposed_id",
                  "proposed_label",
                  "kind",
                  "basis",
                  "authority",
                  "action"
                ],
                "properties": {
                  "proposed_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "proposed_label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authority": {
                    "$ref": "#/$defs/decisionId"
                  },
                  "action": {
                    "const": "add_to_nodes_csv_after_approval"
                  }
                }
              }
            },
            "relabels": {
              "type": "array",
              "maxItems": 0
            },
            "replacements": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "retired_id",
                  "retired_label",
                  "canonical_id",
                  "canonical_label",
                  "kind",
                  "registry_action",
                  "require_no_remaining_retired_endpoints",
                  "authority",
                  "incident_canonical_rows"
                ],
                "properties": {
                  "retired_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retired_label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "canonical_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "canonical_label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "registry_action": {
                    "const": "replace_one_row"
                  },
                  "require_no_remaining_retired_endpoints": {
                    "const": true
                  },
                  "authority": {
                    "$ref": "#/$defs/decisionId"
                  },
                  "incident_canonical_rows": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 2
                    }
                  }
                }
              }
            }
          }
        },
        "canonical_changes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_row",
              "kind",
              "authority",
              "changes",
              "touches_assertion_identity",
              "before"
            ],
            "properties": {
              "canonical_row": {
                "type": "integer",
                "minimum": 2
              },
              "kind": {
                "const": "endpoint_repoint"
              },
              "authority": {
                "$ref": "#/$defs/decisionId"
              },
              "changes": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_id",
                      "source_label"
                    ],
                    "properties": {
                      "source_id": {
                        "$ref": "#/$defs/fieldChange"
                      },
                      "source_label": {
                        "$ref": "#/$defs/fieldChange"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "target_id",
                      "target_label"
                    ],
                    "properties": {
                      "target_id": {
                        "$ref": "#/$defs/fieldChange"
                      },
                      "target_label": {
                        "$ref": "#/$defs/fieldChange"
                      }
                    }
                  }
                ]
              },
              "touches_assertion_identity": {
                "const": true
              },
              "before": {
                "$ref": "#/$defs/edgeRecord"
              }
            }
          }
        },
        "canonical_removals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_row",
              "replacement_edge",
              "authority",
              "action",
              "before"
            ],
            "properties": {
              "canonical_row": {
                "type": "integer",
                "minimum": 2
              },
              "replacement_edge": {
                "type": "null"
              },
              "authority": {
                "$ref": "#/$defs/decisionId"
              },
              "action": {
                "const": "remove_exact_before_image"
              },
              "before": {
                "$ref": "#/$defs/edgeRecord"
              }
            }
          }
        }
      }
    },
    "directDecisionMigrationV2": {
      "type": "object",
      "required": [
        "artifact_kind",
        "operation_model",
        "node_changes",
        "canonical_changes",
        "canonical_removals",
        "provenance"
      ],
      "properties": {
        "artifact_kind": {
          "const": "decision_migration"
        },
        "operation_model": {
          "const": "decision_migration_v2"
        },
        "provenance": {
          "$ref": "#/$defs/directDecisionMigrationV1/properties/provenance"
        },
        "node_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "additions_proposed",
            "relabels",
            "replacements",
            "merges"
          ],
          "properties": {
            "additions_proposed": {
              "type": "array",
              "maxItems": 0
            },
            "relabels": {
              "type": "array",
              "maxItems": 0
            },
            "replacements": {
              "type": "array",
              "maxItems": 0
            },
            "merges": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "canonical_id",
                  "canonical_label",
                  "kind",
                  "retired_nodes",
                  "registry_action",
                  "require_no_remaining_retired_endpoints",
                  "authority",
                  "incident_canonical_rows"
                ],
                "properties": {
                  "canonical_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "canonical_label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retired_nodes": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "registry_csv_row": {
                          "type": "integer",
                          "minimum": 2,
                          "$comment": "Optional observed pinned-baseline locator. V2 merge identity is id and label."
                        }
                      }
                    }
                  },
                  "registry_action": {
                    "const": "merge_retired_rows_into_one"
                  },
                  "require_no_remaining_retired_endpoints": {
                    "const": true
                  },
                  "authority": {
                    "$ref": "#/$defs/decisionId"
                  },
                  "incident_canonical_rows": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 2
                    }
                  }
                }
              }
            }
          }
        },
        "canonical_changes": {
          "allOf": [
            {
              "$ref": "#/$defs/directDecisionMigrationV1/properties/canonical_changes"
            },
            {
              "minItems": 1
            }
          ]
        },
        "canonical_removals": {
          "allOf": [
            {
              "$ref": "#/$defs/directDecisionMigrationV1/properties/canonical_removals"
            },
            {
              "maxItems": 0
            }
          ]
        }
      }
    },
    "labelNormalizationChange": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "from is required to be empty: this operation fills a blank label and is never a rewrite of one somebody wrote.",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "const": ""
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "directDecisionMigrationV3": {
      "type": "object",
      "required": [
        "artifact_kind",
        "operation_model",
        "node_changes",
        "canonical_changes",
        "canonical_removals",
        "provenance"
      ],
      "properties": {
        "artifact_kind": {
          "const": "decision_migration"
        },
        "operation_model": {
          "const": "decision_migration_v3"
        },
        "provenance": {
          "$ref": "#/$defs/directDecisionMigrationV1/properties/provenance"
        },
        "node_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "additions_proposed",
            "relabels",
            "replacements"
          ],
          "properties": {
            "additions_proposed": {
              "type": "array",
              "maxItems": 0
            },
            "relabels": {
              "type": "array",
              "maxItems": 0
            },
            "merges": {
              "type": "array",
              "maxItems": 0
            },
            "replacements": {
              "allOf": [
                {
                  "$ref": "#/$defs/directDecisionMigrationV1/properties/node_changes/properties/replacements"
                },
                {
                  "minItems": 1
                }
              ]
            }
          }
        },
        "canonical_changes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/v3Repoint"
              },
              {
                "$ref": "#/$defs/v3LabelNormalization"
              }
            ]
          }
        },
        "canonical_removals": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "v3Repoint": {
      "$ref": "#/$defs/directDecisionMigrationV1/properties/canonical_changes/items"
    },
    "v3LabelNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_row",
        "kind",
        "authority",
        "changes",
        "touches_assertion_identity",
        "before"
      ],
      "properties": {
        "canonical_row": {
          "type": "integer",
          "minimum": 2
        },
        "kind": {
          "const": "endpoint_label_normalization"
        },
        "authority": {
          "$ref": "#/$defs/decisionId"
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "source_label": {
              "$ref": "#/$defs/labelNormalizationChange"
            },
            "target_label": {
              "$ref": "#/$defs/labelNormalizationChange"
            }
          }
        },
        "touches_assertion_identity": {
          "const": false
        },
        "before": {
          "$ref": "#/$defs/edgeRecord"
        }
      }
    }
  }
}

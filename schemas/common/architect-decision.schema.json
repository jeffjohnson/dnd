{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/common/architect-decision.schema.json",
  "title": "Architect Decision",
  "$comment": "WORK_QUEUES 1.6: a Decision may classify its own acceptance tests, and may authorize a retired-by-lineage outcome for an earlier Decision that could not. Both shapes are exact by construction: an index, a checksum, and a complete subject list, so neither Builder nor Reviewer can widen a named subject into an inferred class of work.",
  "allOf": [
    {
      "$ref": "artifact-envelope.schema.json"
    }
  ],
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "acceptance_test_semantics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "$comment": "Declared by the Decision that owns the acceptance tests. A snapshot test must enumerate the subjects it names, so a later report cannot choose them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acceptance_test_index",
          "kind"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "live_queue_snapshot"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "subjects"
              ]
            }
          }
        ],
        "properties": {
          "acceptance_test_index": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "live_queue_snapshot"
            ]
          },
          "retirement_allowed": {
            "type": "boolean"
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/namedSubject"
            }
          }
        }
      }
    },
    "retired_acceptance_authorizations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "$comment": "Issued by a later approved Decision to resolve a legacy Decision whose acceptance tests carry no structured semantics. It pins the authorized Decision by checksum, so rewriting that Decision invalidates the authorization rather than silently widening it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_input",
          "acceptance_test_index",
          "kind",
          "retirement_allowed",
          "subjects"
        ],
        "properties": {
          "decision_input": {
            "$ref": "#/$defs/decisionInput"
          },
          "acceptance_test_index": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "live_queue_snapshot"
            ]
          },
          "retirement_allowed": {
            "type": "boolean"
          },
          "subjects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/authorizedSubject"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}-[0-9]{4}$"
    },
    "decisionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "checksum"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/decisionId"
        },
        "path": {
          "type": "string",
          "pattern": "^rulesets/[a-z0-9-]+/escalations/decisions/DEC-[0-9]{4}-[0-9]{4}\\.yaml$"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "namedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorizedSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "permitted_retirement_state",
        "integration_record_path"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "permitted_retirement_state": {
                "const": "superseded_by_integrated_revision"
              }
            },
            "required": [
              "permitted_retirement_state"
            ]
          },
          "then": {
            "required": [
              "integrated_successor_id"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "permitted_retirement_state": {
          "enum": [
            "consumed_by_integrated_bundle",
            "superseded_by_integrated_revision"
          ]
        },
        "integrated_successor_id": {
          "type": "string",
          "minLength": 1
        },
        "integration_record_path": {
          "type": "string",
          "pattern": "^books/[a-z0-9-]+/[a-z0-9-]+/artifacts/integrated/INT-.+\\.json$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AD&D 1e Graph Update Recommendation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "id",
    "status",
    "ruleset_id",
    "book_id",
    "source_id",
    "packet_id",
    "constitution_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "ruleset_id": {
      "const": "adnd1e"
    },
    "book_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "packet_id": {
      "type": "string"
    },
    "constitution_version": {
      "type": "string"
    }
  }
}

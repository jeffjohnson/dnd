{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Players Handbook Source Metadata",
  "type": "object",
  "required": [
    "ruleset_id",
    "book_id",
    "source_id"
  ],
  "properties": {
    "ruleset_id": {
      "const": "adnd1e"
    },
    "book_id": {
      "const": "phb"
    },
    "source_id": {
      "type": "string"
    },
    "edition_or_printing": {
      "type": "string"
    },
    "page_number_basis": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AD&D 1e playable character race registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "ruleset_id",
    "version",
    "status",
    "scope",
    "membership_policy",
    "broad_classes",
    "members",
    "groups",
    "non_members",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_id": {
      "const": "adnd1e_character_races"
    },
    "ruleset_id": {
      "const": "adnd1e"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "active",
        "deprecated"
      ]
    },
    "scope": {
      "const": "playable_character_races"
    },
    "membership_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure",
        "amendment_owner",
        "identity_authority",
        "mechanical_inheritance"
      ],
      "properties": {
        "closure": {
          "const": "closed"
        },
        "amendment_owner": {
          "const": "architect"
        },
        "identity_authority": {
          "const": "rulesets/adnd1e/registries/nodes.csv"
        },
        "mechanical_inheritance": {
          "const": "none"
        }
      }
    },
    "broad_classes": {
      "type": "array",
      "prefixItems": [
        {
          "const": "human"
        },
        {
          "const": "demihuman"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "members": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "broad_class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^race_[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "broad_class": {
            "enum": [
              "human",
              "demihuman"
            ]
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "member_ids"
        ],
        "properties": {
          "id": {
            "enum": [
              "race_any",
              "race_demihuman"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "member_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^race_[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "non_members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^race_[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
